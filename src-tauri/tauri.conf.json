{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnTun",
  "version": "1.7.5",
  "identifier": "com.antun.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnTun",
        "width": 920,
        "height": 660,
        "minWidth": 600,
        "minHeight": 440,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#F5F7FB"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/mihomo.exe",
      "resources/psiphon.exe",
      "resources/client.config",
      "resources/server_list.dat",
      "resources/GPL-3.0.txt"
    ],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png"],
    "copyright": "AnTun 1.7.5 - MIT License",
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser"
      }
    }
  }
}
